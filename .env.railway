# Railway 部署环境变量配置
# 复制此文件内容到 Railway 的环境变量设置中

# 端口（Railway 会自动设置 PORT）
PORT=3000

# 数据库配置（使用 SQLite）
SQLITE_PATH=/app/data/new-api.db

# 会话密钥（请修改为随机字符串）
SESSION_SECRET=change-this-to-random-string-for-production

# 前端基础URL（部署后修改为你的 Cloudflare Pages 域名）
FRONTEND_BASE_URL=https://all-in.cc.cd

# 启用内存缓存
MEMORY_CACHE_ENABLED=true

# 同步频率（秒）
SYNC_FREQUENCY=600

# 生成默认token
GENERATE_DEFAULT_TOKEN=true

# 节点类型
NODE_TYPE=master
